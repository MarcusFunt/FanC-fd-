FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    // kOmegaSST is recommended for turbomachinery flows
    // (adverse pressure gradients, separated boundary layers)
    RASModel        {{TURBULENCE_MODEL}};

    turbulence      on;
    printCoeffs     on;
}

